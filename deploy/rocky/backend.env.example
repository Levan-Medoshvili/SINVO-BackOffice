# Root-owned /etc/pos-erp/backend.env, mode 600. Fresh PostgreSQL setup generates it.
SIMPLEPOS_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
SIMPLEPOS_DEBUG=0
SIMPLEPOS_BRAND=SimplePOS
SIMPLEPOS_ALLOWED_HOSTS=10.0.110.151,127.0.0.1,localhost
SIMPLEPOS_CSRF_ORIGINS=http://10.0.110.151
SIMPLEPOS_HTTPS=0
SIMPLEPOS_DATA_DIR=/var/lib/pos-erp
SIMPLEPOS_OFFLINE_LOGIN_DAYS=7
SIMPLEPOS_ALLOW_LEGACY_SALES=0
SIMPLEPOS_RELEASE_DIR=/var/lib/pos-erp/cashier-releases
DB_ENGINE=postgres
DB_NAME=simplepos_erp
DB_USER=simplepos_erp
DB_PASSWORD=REPLACE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
# MySQL: DB_ENGINE=mysql, port 3306; DB_SSL_CA for a remote TLS server.
# SQL Server: DB_ENGINE=mssql, port 1433; ODBC Driver 18 installed by the pipeline.
DB_TRUST_SERVER_CERTIFICATE=0
# Public verification key only; keep the private signing key off this server.
SIMPLEPOS_RELEASE_PUBLIC_KEY=/etc/pos-erp/cashier-release-public.pem
